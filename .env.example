APP_NAME="AI-PGAALS"
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_REAL_LARAVEL_APP_KEY
APP_DEBUG=false
APP_URL=https://smartlearn6.site
APP_PORT=80
ASSET_URL=
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=pgaals
DB_USERNAME=pgaals
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DATABASE_ROOT_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_DOMAIN=smartlearn6.site
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=smartlearn6.site

TEACHER_REGISTRATION_CODE=REPLACE_WITH_TEACHER_REGISTRATION_CODE
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@smartlearn6.site
ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
ADMIN_SECTION="Admin-Office"
ADMIN_SYNC_PASSWORD=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@smartlearn6.site"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Enable only after configuring the school's OpenAI data protections (docs/student-tutor.md).
OPENAI_TUTOR_ENABLED=false
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-6-astra

# Optional local FastAPI service from ai_pgaals_ml/.
ML_PREDICTIONS_ENABLED=false
ML_PREDICTION_API_URL=
ML_PREDICTION_TIMEOUT=5
ML_READING_MODEL_NAME=reading_level_random_forest_v1
